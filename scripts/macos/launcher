#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
APP_ROOT="$( cd "$DIR/../.." && pwd )"
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.docker/bin:$HOME/.orbstack/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH"

JAVA_EXEC=""

# 1. Check bundled runtime if exists
if [ -x "$APP_ROOT/Contents/PlugIns/jre/Contents/Home/bin/java" ]; then
    JAVA_EXEC="$APP_ROOT/Contents/PlugIns/jre/Contents/Home/bin/java"
elif [ -x "$DIR/runtime/bin/java" ]; then
    JAVA_EXEC="$DIR/runtime/bin/java"
fi

# 2. Check Homebrew OpenJDK 17/21
if [ -z "$JAVA_EXEC" ]; then
    for brew_java in \
        "/opt/homebrew/opt/openjdk@17/bin/java" \
        "/opt/homebrew/opt/openjdk@21/bin/java" \
        "/opt/homebrew/opt/openjdk/bin/java" \
        "/usr/local/opt/openjdk@17/bin/java" \
        "/usr/local/opt/openjdk@21/bin/java" \
        /opt/homebrew/Cellar/openjdk@17/*/libexec/openjdk.jdk/Contents/Home/bin/java \
        /opt/homebrew/Cellar/openjdk@21/*/libexec/openjdk.jdk/Contents/Home/bin/java; do
        if [ -x "$brew_java" ]; then
            JAVA_EXEC="$brew_java"
            break
        fi
    done
fi

# 3. Check macOS java_home
if [ -z "$JAVA_EXEC" ]; then
    JH_17=$(/usr/libexec/java_home -v 17+ 2>/dev/null || true)
    if [ -n "$JH_17" ] && [ -x "$JH_17/bin/java" ]; then
        JAVA_EXEC="$JH_17/bin/java"
    fi
fi

# 4. Check common Application Support runtimes (Zulu, Temurin, Minecraft, Modrinth)
if [ -z "$JAVA_EXEC" ]; then
    for app_java in \
        "$HOME/Library/Application Support/minecraft/runtime/java-runtime-delta/mac-os-arm64/java-runtime-delta/jre.bundle/Contents/Home/bin/java" \
        "$HOME/Library/Application Support/ModrinthApp/meta/java_versions/"*"/Contents/Home/bin/java" \
        "$HOME/Library/Java/JavaVirtualMachines/"*"/Contents/Home/bin/java" \
        "/Library/Java/JavaVirtualMachines/"*"/Contents/Home/bin/java"; do
        if [ -x "$app_java" ]; then
            VER=$("$app_java" -version 2>&1 | awk -F '"' '/version/ {print $2}' | cut -d'.' -f1)
            if [ -n "$VER" ] && [ "$VER" -ge 17 ] 2>/dev/null; then
                JAVA_EXEC="$app_java"
                break
            fi
        fi
    done
fi

# 5. Check PATH java
if [ -z "$JAVA_EXEC" ]; then
    if command -v java >/dev/null 2>&1; then
        VER=$(java -version 2>&1 | awk -F '"' '/version/ {print $2}' | cut -d'.' -f1)
        if [ -n "$VER" ] && [ "$VER" -ge 17 ] 2>/dev/null; then
            JAVA_EXEC="java"
        fi
    fi
fi

# 6. If no Java 17+ is found, show native macOS dialog and open download link
if [ -z "$JAVA_EXEC" ]; then
    BUTTON=$(osascript -e 'display dialog "PostgreSQL DDL Studio çalışmak için Java 17 veya üstünü gerektirir.\n\nSisteminizde Java 17 bulunamadı. Lütfen ücretsiz OpenJDK 17 yükleyin." with title "Java 17 Gerekli" buttons {"İptal", "Java 17 İndir"} default button "Java 17 İndir" with icon caution' 2>/dev/null || echo "Java 17 İndir")
    if [[ "$BUTTON" == *"Java 17 İndir"* ]]; then
        open "https://adoptium.net/temurin/releases/?version=17"
    fi
    exit 1
fi

exec "$JAVA_EXEC" -Xdock:name="PostgreSQL DDL Studio" -jar "$DIR/app.jar" "$@"
